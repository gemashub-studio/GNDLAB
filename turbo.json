{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "../../architecture/00-research/data/**"],
      "outputs": ["src/generated/**", "dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["src/**", "test/**", "../../architecture/tests/fixtures/**", "../../architecture/00-research/data/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"]
    }
  }
}
