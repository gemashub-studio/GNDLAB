{
  "name": "@gemas/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "vercel-build": "node ../../packages/dataset/scripts/sync-dataset.mjs && prisma generate && next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db execute --file ../../architecture/03-data/seed.sql --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@gemas/calc-engine": "workspace:*",
    "@gemas/dataset": "workspace:*",
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "4.9.0",
    "@react-three/fiber": "9.8.1",
    "@serwist/next": "9.5.13",
    "gsap": "3.15.0",
    "idb": "8.0.4",
    "next": "15.5.27",
    "next-auth": "4.24.15",
    "nodemailer": "^7.0.10",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.186.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "serwist": "9.5.13",
    "tailwindcss": "3.4.19",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
