{
  "name": "gemasSTUDIO — Lab Futuristik",
  "version": "2.0.0",
  "replaces": "Punk Skate Lab 1.0.0 (ADR-011)",
  "note": "Nama token warna dipertahankan agar kelas Tailwind lama tetap berlaku; nilainya yang berubah.",
  "color": {
    "ink":        { "value": "#0E1A1F", "use": "teks utama, sidebar, panel gelap, kepala tabel" },
    "paper":      { "value": "#F3F6F7", "use": "latar halaman putih-dingin" },
    "paperGrid":  { "value": "#E2E8EA", "use": "garis grid 32px pada latar" },
    "surface":    { "value": "#FFFFFF", "use": "kartu (90% + blur tipis)" },
    "acid":       { "value": "#63E6CF", "use": "aksen utama mint: aktif, fokus, keyakinan A, teks aksen di atas ink" },
    "safety":     { "value": "#F5A524", "use": "aksen kedua amber: tombol utama, peringatan, keyakinan C, out-of-spec" },
    "muted":      { "value": "#5B6B72", "use": "label sekunder di atas putih/kertas" },
    "mutedOnInk": { "value": "#A9B8BE", "use": "teks sekunder di atas ink" },
    "lineOnInk":  { "value": "#2A3A41", "use": "garis tipis di atas ink" }
  },
  "semantic": {
    "confidence": { "A": { "bg": "#63E6CF", "fg": "#0E1A1F" }, "B": { "bg": "#FFFFFF", "fg": "#0E1A1F" }, "C": { "bg": "#F5A524", "fg": "#0E1A1F" } },
    "binding":    { "VOLUME": { "bg": "#0E1A1F", "fg": "#63E6CF" }, "WEIGHT": { "bg": "#F5A524", "fg": "#0E1A1F" } },
    "outOfSpec":  { "bg": "#F5A524", "fg": "#0E1A1F" }
  },
  "font": {
    "display": { "family": "Space Grotesk", "weights": [500, 600, 700], "use": "judul (huruf biasa, tracking -0.02em), angka hasil besar" },
    "body":    { "family": "Archivo", "weights": [400, 500, 700, 800], "use": "teks, tombol (700)" },
    "mono":    { "family": "JetBrains Mono", "weights": [400, 600, 700], "use": "angka tabel, label lab, kode batch, satuan" }
  },
  "size": { "h1": 56, "h2": 24, "body": 15, "label": 11, "micro": 11, "resultHero": 72 },
  "border": { "card": 1, "control": 1, "lineAlpha": 0.16, "radiusCard": 16, "radiusControl": 12, "radiusPill": 999 },
  "shadow": {
    "card": "0 1px 2px rgba(14,26,31,0.06), 0 10px 30px -12px rgba(14,26,31,0.18)",
    "cardOnInk": "0 0 0 1px rgba(99,230,207,0.35), 0 12px 32px -12px rgba(99,230,207,0.45)",
    "pressed": "0 1px 2px rgba(14,26,31,0.08), 0 4px 12px -6px rgba(14,26,31,0.2)"
  },
  "space": { "pagePadX": 40, "pagePadY": 32, "sectionGap": 24, "cardPad": 22 },
  "target": { "minTouch": 44 },
  "motif": {
    "labGrid": "grid 32px #E2E8EA + cahaya radial mint lembut di pojok kanan atas",
    "inkPanel": "panel ink dengan grid mint 7% + cahaya radial mint, dipakai untuk hero/detail",
    "noTilt": "tanpa elemen miring (stiker dihapus)",
    "monoTag": "label mono kapital kecil dalam pill ink/mint"
  }
}
