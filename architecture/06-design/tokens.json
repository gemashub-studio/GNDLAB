{
  "name": "gemasSTUDIO — Punk Skate Lab",
  "version": "1.0.0",
  "color": {
    "ink":        { "value": "#111111", "use": "teks, garis tebal, sidebar, bayangan keras" },
    "paper":      { "value": "#EFEDE4", "use": "latar halaman (kertas lab)" },
    "paperGrid":  { "value": "#DAD6C8", "use": "garis grid 24px pada latar" },
    "surface":    { "value": "#FFFFFF", "use": "kartu" },
    "acid":       { "value": "#C6F135", "use": "aksen utama: aksi aktif, highlight, keyakinan A, isi < 75%" },
    "safety":     { "value": "#FF5A1F", "use": "aksen kedua: CTA, peringatan, keyakinan C, isi ≥ 75%, bayangan pada panel gelap" },
    "muted":      { "value": "#55534B", "use": "label sekunder di atas putih/kertas (kontras ≥ 7:1)" },
    "mutedOnInk": { "value": "#CFCCC0", "use": "teks sekunder di atas hitam" },
    "lineOnInk":  { "value": "#3A3A3A", "use": "garis tipis di atas hitam" }
  },
  "semantic": {
    "confidence": { "A": { "bg": "#C6F135", "fg": "#111111" }, "B": { "bg": "#FFFFFF", "fg": "#111111" }, "C": { "bg": "#FF5A1F", "fg": "#111111" } },
    "binding":    { "VOLUME": { "bg": "#111111", "fg": "#C6F135" }, "WEIGHT": { "bg": "#FF5A1F", "fg": "#111111" } },
    "outOfSpec":  { "bg": "#FF5A1F", "fg": "#111111" }
  },
  "font": {
    "display": { "family": "Bowlby One", "use": "judul, angka hasil besar; selalu UPPERCASE" },
    "body":    { "family": "Archivo", "weights": [400, 500, 700, 800], "use": "teks, tombol (800 UPPERCASE)" },
    "mono":    { "family": "JetBrains Mono", "weights": [400, 600, 700], "use": "angka tabel, label lab, kode batch, satuan" },
    "googleFontsCss": "https://fonts.googleapis.com/css2?family=Bowlby+One&family=Archivo:wght@400;500;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap"
  },
  "size": { "h1": 52, "h2": 24, "body": 14, "label": 12, "micro": 11, "resultHero": 72 },
  "border": { "card": 3, "control": 2, "radius": 0 },
  "shadow": { "card": "6px 6px 0 #111111", "cardOnInk": "6px 6px 0 #FF5A1F", "pressed": "4px 4px 0 #111111" },
  "space": { "pagePadX": 40, "pagePadY": 32, "sectionGap": 24, "cardPad": 22 },
  "target": { "minTouch": 44 },
  "motif": {
    "labGrid": "background-image: linear-gradient(#DAD6C8 1px,transparent 1px), linear-gradient(90deg,#DAD6C8 1px,transparent 1px); background-size: 24px 24px",
    "stickerTilt": "rotate(-6deg .. 2deg) untuk badge/stiker, maksimal satu per kartu",
    "monoTag": "label UPPERCASE mono dengan latar ink/acid, mis. 'NEXT DROP', 'EXP-CALC'"
  }
}
