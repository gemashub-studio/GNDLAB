    { "id": "congkel", "name_id": "Congkel daging (WS 2.D)", "kind": "manual", "unit": "butir", "rate_per_person_h": { "min": 160, "typ": 205, "max": 250, "unit": "butir/h", "confidence": "C", "source_ids": ["F19"], "note": "UNIDO 1982 (kapak kecil)" } },
