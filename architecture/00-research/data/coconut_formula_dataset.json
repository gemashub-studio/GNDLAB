    { "id": "hammer_mill", "name_id": "Hammer mill (WS 3.A)", "kind": "machine", "unit": "kg", "rate_per_unit_h": { "min": 21, "typ": 21, "max": 157, "unit": "kg/h", "confidence": "C", "source_ids": ["F02"] } }
  ],
  "checklists": [
    { "id": "qc-kpr-terima", "type": "qc", "product": "kopra", "stage": "Penerimaan kelapa (WS 2.A)", "form_ref": "F-K01", "items": [
      { "text": "Kematangan: sabut coklat, bunyi air jelas (tua 11–12 bln)", "critical": false },
      { "text": "Tidak retak/bocor", "critical": true },
      { "text": "Tidak bertunas (kentos)", "critical": false },
      { "text": "Tidak busuk/bau, mata tidak berjamur", "critical": true },
      { "text": "Bersih dari lumpur", "critical": false },
      { "text": "Bebas hama/lubang gerek", "critical": false },
      { "text": "Tebal daging (belah 10 butir) ≥1 cm, putih padat", "critical": false },
      { "text": "Sampel ≥50 butir atau 2%; cacat ≤10% → terima", "critical": true },
      { "text": "Asal kebun & DR/DT tercatat lengkap", "critical": true }
    ], "source_ids": ["F01"] },
    { "id": "qc-kpr-jagal", "type": "qc", "product": "kopra", "stage": "Jagal & aturan 4 jam (WS 2.B)", "form_ref": "F-K03", "items": [
      { "text": "Meja, corong, saringan bersih di awal shift", "critical": false },
      { "text": "Jam belah dicatat per keranjang", "critical": true },
      { "text": "Belah → pengering ≤4 jam (lewat = maksimal Reguler)", "critical": true },
      { "text": "Sabut dikumpulkan terpisah dari batok", "critical": false },
      { "text": "Sampling salah sortir 10 keranjang ≤5%", "critical": false },
      { "text": "Air kelapa masuk pendingin ≤2 jam, ≤10°C", "critical": true }
    ], "source_ids": ["F01"] },
    { "id": "qc-kpr-kering", "type": "qc", "product": "kopra", "stage": "Pengeringan & fumigasi (WS 2.F)", "form_ref": "F-K05/F-K06/F-K07", "items": [
      { "text": "KA 24 jam ≤35%", "critical": false },
      { "text": "KA 48 jam ≤20% (bila tidak → pindah oven, tandai batch)", "critical": true },
      { "text": "Suhu oven ≤70°C, rotasi tray tiap 2–4 jam", "critical": true },
      { "text": "Fumigasi: tak ada orang di dalam, kipas OFF, rambu & kunci", "critical": true },
      { "text": "Respirator gas asam dipakai operator fumigasi", "critical": true },
      { "text": "Fumigasi ≥3 malam → sampel uji SO₂ dikirim", "critical": true },
      { "text": "Maks 4 malam fumigasi (100/50/25/25%)", "critical": true }
    ], "source_ids": ["F01"] },
    { "id": "qc-kpr-grading", "type": "qc", "product": "kopra", "stage": "Grading & packing", "form_ref": "F-K09/F-K10", "items": [
      { "text": "KA 10 sampel, rata-rata & tertinggi dicatat", "critical": true },
      { "text": "Tidak ada potong >1 poin di atas batas grade", "critical": true },
      { "text": "Warna, kapang (termasuk sisi bawah), benda asing, bau diperiksa", "critical": true },
      { "text": "Verifikasi ulang KA 3 sampel sebelum karung ditutup", "critical": true },
      { "text": "Label: produk, grade, lot DR/DT, batch, tanggal, berat, KORA", "critical": false },
      { "text": "Kopra turun grade/dicuci tidak dicampur ke grade lebih tinggi", "critical": true }
    ], "source_ids": ["F01"] },
    { "id": "qc-arg-karbon", "type": "qc", "product": "arang", "stage": "Karbonisasi (WS 1.A/1.B/1.C)", "form_ref": "F-A03/F-A04", "items": [
      { "text": "Radius 5 m bersih bahan mudah terbakar; APAR, pasir, tanah liat siap", "critical": true },
      { "text": "Minimal 2 orang selama tungku menyala", "critical": true },
      { "text": "Satu tungku = satu lot (DR/DT tidak dicampur); batok ditimbang", "critical": false },
      { "text": "KA batok ≤15%", "critical": false },
      { "text": "Pirolisis: suhu reaktor 450–500°C dicatat tiap 30 menit", "critical": false },
      { "text": "Mati hampa tanpa air ≥8 jam; cek bocor 15 menit", "critical": true },
      { "text": "Rendemen = kg arang ÷ kg batok dicatat", "critical": false }
    ], "source_ids": ["F02"] },
    { "id": "qc-arg-ayak", "type": "qc", "product": "arang", "stage": "Ayak, QC & packing", "form_ref": "F-A05/F-A07", "items": [
      { "text": "Arang dingin ≤40°C sebelum ayak/packing", "critical": true },
      { "text": "% mentah (20 potong acak) ≤5%", "critical": false },
      { "text": "KA, abu, VM sesuai standar (SNI 01-1682 / ICC)", "critical": true },
      { "text": "≤5% lolos ayakan 6,3 mm", "critical": false },
      { "text": "Ekspor: weathering ≥14 hari (IMDG SP 978)", "critical": true },
      { "text": "Karung ekspor ≤30 kg, label UN 1361 kelas 4.2", "critical": true }
    ], "source_ids": ["F02", "F14"] },
    { "id": "qc-arg-giling", "type": "qc", "product": "arang", "stage": "Hammer mill & ayak sortase (WS 3.A/3.B)", "form_ref": "F-A06", "items": [
      { "text": "Guard, grounding, sabuk & baut OK", "critical": true },
      { "text": "Pengendali debu ON sebelum mesin", "critical": true },
      { "text": "Tidak ada api/rokok/gerinda di ruang giling", "critical": true },
      { "text": "Screen tidak sobek; uji ukuran 100 g/shift ≥90% sesuai", "critical": false },
      { "text": "Debu dibersihkan basah/sedot, tidak ditiup", "critical": true },
      { "text": "APD: respirator P2, kacamata, pelindung telinga", "critical": true }
    ], "source_ids": ["F02"] },
    { "id": "qc-brk-proses", "type": "qc", "product": "briket", "stage": "Adonan, cetak & oven", "form_ref": "Modul QC 7.2", "items": [
      { "text": "Air proses: TDS <300 ppm, pH 6,5–8,5 (Fe <0,3 mg/L)", "critical": false },
      { "text": "Perekat tergelatinisasi ≥65°C (air panas:dingin ±70:30)", "critical": true },
      { "text": "Kadar air adonan 22–28%, merata", "critical": true },
      { "text": "Aging adonan semalam sebelum cetak", "critical": false },
      { "text": "Angin-anginkan 2–6 jam sebelum oven (cegah case hardening)", "critical": false },
      { "text": "Oven bertahap 60–90°C, 8–24 jam; suhu & jam dicatat", "critical": true }
    ], "source_ids": ["F04"] },
    { "id": "qc-cka", "type": "qc", "product": "cuka", "stage": "Cuka air kelapa", "form_ref": "F-C01..F-C04", "items": [
      { "text": "Air kelapa: pH >5, segar, tak berbusa; ≤10°C dalam ≤2 jam", "critical": true },
      { "text": "Must 14–17 °Brix; pasteurisasi 60–65°C 10–15 mnt", "critical": true },
      { "text": "Wadah bahan antara berlabel 'BUKAN UNTUK DIKONSUMSI', ruang terkunci", "critical": true },
      { "text": "Fermentasi alkohol 28–30°C; selesai bila gelembung berhenti & °Brix stabil 2 hari", "critical": false },
      { "text": "Titrasi mingguan; N NaOH & volume sampel dicatat", "critical": true },
      { "text": "Asam asetat ≥4% & sisa alkohol ≤0,5% sebelum pembotolan", "critical": true },
      { "text": "Pasteurisasi botol 60–71°C ≥30 mnt; 2 botol arsip", "critical": true }
    ], "source_ids": ["F03"] },
    { "id": "qc-blt", "type": "qc", "product": "bioleather", "stage": "Bioleather", "form_ref": "F-C05..F-C07", "items": [
      { "text": "Media: sukrosa 10%, ZA 0,5%, pH 4,0–4,5", "critical": true },
      { "text": "Baki tidak digoyang/dipindah selama kultur", "critical": true },
      { "text": "Cek kontaminasi harian; baki terkontaminasi dibuang seluruhnya", "critical": true },
      { "text": "NaOH maks 0,1 M; APD kimia lengkap", "critical": true },
      { "text": "Bilas sampai pH netral (±7)", "critical": false },
      { "text": "Kering 30–40°C di rangka sampai berat konstan", "critical": false }
    ], "source_ids": ["F03"] },
    { "id": "rnd-kopra", "type": "rnd", "product": "kopra", "stage": "Rencana batch R&D kopra edible", "form_ref": "Rencana R&D Ronde 1", "items": [
      { "text": "Satu variabel diubah per percobaan (kematangan / jeda / suhu / pemutih / metode)", "critical": true },
      { "text": "Kode batch unik; perlakuan & ulangan tercatat", "critical": true },
      { "text": "Logger suhu/RH di ≥5 titik greenhouse; posisi rak diacak", "critical": false },
      { "text": "Berat awal, jam belah & jam masuk pengering dicatat", "critical": true },
      { "text": "KA tiap 12 jam sampai stabil", "critical": false },
      { "text": "Uji akhir: KA, warna, jamur, FFA, minyak, aflatoksin, SO₂ (bila sulfur)", "critical": true },
      { "text": "Resep lolos 3 ulangan berturut sebelum dikunci", "critical": true }
    ], "source_ids": ["F05"] },
    { "id": "rnd-briket", "type": "rnd", "product": "briket", "stage": "Rencana batch R&D briket", "form_ref": "—", "items": [
      { "text": "Fraksi serbuk (mesh) & sumber arang (lot DR/DT) tercatat", "critical": true },
      { "text": "Dosis perekat diuji bertingkat (mis. 4/6/8%) — satu variabel per batch", "critical": true },
      { "text": "Air adonan diukur, bukan dikira-kira", "critical": true },
      { "text": "Tekanan/alat cetak & dimensi dicatat", "critical": false },
      { "text": "Uji bakar: waktu nyala, waktu bakar, warna abu, percikan, bau", "critical": true },
      { "text": "Uji lab: KA, abu, VM, FC, kalor (lab eksternal per lot)", "critical": true }
    ], "source_ids": ["F04", "F07"] },
    { "id": "rnd-cuka", "type": "rnd", "product": "cuka", "stage": "Rencana batch R&D cuka", "form_ref": "Tracker Ronde 1 — sheet Cuka", "items": [
      { "text": "Variabel: dosis ragi, Brix awal, % starter, umur air kelapa", "critical": true },
      { "text": "Brix & pH awal diukur sebelum hitung gula", "critical": true },
      { "text": "Gula dihitung dengan neraca massa (bukan rumus lama)", "critical": true },
      { "text": "Log titrasi mingguan per toples", "critical": true },
      { "text": "Rendemen liter cuka per liter air kelapa dicatat (GAP)", "critical": false }
    ], "source_ids": ["F03", "F05"] },
    { "id": "rnd-blt", "type": "rnd", "product": "bioleather", "stage": "Rencana batch R&D bioleather", "form_ref": "Tracker Ronde 1 — sheet Bioleather", "items": [
      { "text": "Variabel: umur air kelapa (0 vs 2 hari), gula, tebal media, gliserol", "critical": true },
      { "text": "Tebal pelikel hari 7/14/21 dicatat", "critical": false },
      { "text": "Berat basah & kering → rendemen", "critical": true },
      { "text": "Uji tarik (≥20 MPa) & lipat (≥100×)", "critical": true },
      { "text": "Mother cuka (BLT-M) dibandingkan dengan kultur khusus", "critical": false }
    ], "source_ids": ["F03", "F05"] },
    { "id": "prd-kopra-edible", "type": "product", "product": "kopra", "stage": "Rilis produk: Kopra Edible", "form_ref": "F-K09 / CoA", "items": [
      { "text": "KA ≤6,0%", "critical": true },
      { "text": "Minyak ≥60%, FFA ≤1% (lab)", "critical": true },
      { "text": "Aflatoksin ≤5 ppb (lab terakreditasi)", "critical": true },
      { "text": "Residu SO₂ sesuai negara tujuan (UE ≤50 mg/kg) bila fumigasi", "critical": true },
      { "text": "Kapang 0%, benda asing ≤0,5%, putih merata, tanpa bau asap/tengik", "critical": true },
      { "text": "Karung berlapis PE, label lengkap, KA verifikasi 3 sampel", "critical": false }
    ], "source_ids": ["F01", "F09"] },
    { "id": "prd-arang-ekspor", "type": "product", "product": "arang", "stage": "Rilis produk: Arang batok ekspor", "form_ref": "F-A05 / RoA", "items": [
      { "text": "KA, abu, VM, FC sesuai kontrak (acuan ICC: KA <10, abu ≤2, VM ≤15, FC ≥75)", "critical": true },
      { "text": "Weathering ≥14 hari & suhu ≤40°C saat packing", "critical": true },
      { "text": "Dokumen: RoA, MSDS, COO, dokumen UN 1361 kelas 4.2", "critical": true },
      { "text": "Kontainer bersih kering; ruang kosong ≥30 cm di atas muatan", "critical": false }
    ], "source_ids": ["F02", "F14"] },
    { "id": "prd-briket-shisha", "type": "product", "product": "briket", "stage": "Rilis produk: Briket shisha", "form_ref": "Modul QC 6.4", "items": [
      { "text": "KA ≤8%, abu ≤3% (premium ≤2%), FC ≥75%", "critical": true },
      { "text": "Kalor ≥7.000 kkal/kg (sesuai kontrak)", "critical": true },
      { "text": "Waktu bakar ≥60 mnt/kubus; nyala ≤10 mnt", "critical": true },
      { "text": "Abu putih; tanpa percikan; tanpa bau/asap menyengat", "critical": true },
      { "text": "Dimensi ±1 mm; pecah ≤5% per karton sampel", "critical": false },
      { "text": "Sampel uji bakar ≥10 kubus/100 kg", "critical": false }
    ], "source_ids": ["F04"] },
    { "id": "prd-briket-bbq", "type": "product", "product": "briket", "stage": "Rilis produk: Briket BBQ", "form_ref": "Modul QC 7.5", "items": [
      { "text": "KA produk jadi ≤8%", "critical": true },
      { "text": "Abu ≤5%, abu putih merata", "critical": true },
      { "text": "Waktu bakar 2–3 jam", "critical": true },
      { "text": "Dimensi 5×10 cm ±2 mm; cacat retak/chipping ≤5%", "critical": false },
      { "text": "Tanpa bau tar/asap menyengat", "critical": true },
      { "text": "Sampel ≥5 batang/50 kg", "critical": false }
    ], "source_ids": ["F04"] },
    { "id": "prd-cuka", "type": "product", "product": "cuka", "stage": "Rilis produk: Cuka air kelapa", "form_ref": "B6.1 / F-C04", "items": [
      { "text": "Asam asetat ≥4,0% (target 5%)", "critical": true },
      { "text": "Sisa alkohol ≤0,5% v/v", "critical": true },
      { "text": "Pb ≤1, As ≤1, Cu ≤5 mg/kg (lab, per 6 bulan/lot jual)", "critical": true },
      { "text": "Jernih, kuning pucat, tanpa partikel & tanpa cacing cuka", "critical": true },
      { "text": "Label: keasaman (angka bulat), volume, batch, tanggal, izin edar, alergen bila putih telur", "critical": true }
    ], "source_ids": ["F03", "F13"] },
    { "id": "prd-bioleather", "type": "product", "product": "bioleather", "stage": "Rilis produk: Bioleather", "form_ref": "F-C07", "items": [
      { "text": "Kuat tarik ≥20 MPa (ISO 3376)", "critical": true },
      { "text": "Lipat 180° ≥100× tanpa retak", "critical": true },
      { "text": "Tebal seragam ±10%", "critical": false },
      { "text": "Tanpa lubang, gelembung, bintik kapang, lengket", "critical": true },
      { "text": "Grade A (kultur) / B (mother cuka) ditandai", "critical": false }
    ], "source_ids": ["F03"] }
  ],
